# ReachInbox Docker Environment Configuration Example
# Copy to backend/.env when running against local Docker services:
# cp .env.docker.example backend/.env

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Local Docker PostgreSQL
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db
PGSSLMODE=disable

# Local Docker Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# Local Docker Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Rate Limiting & Pacing Defaults
DEFAULT_HOURLY_LIMIT=200
DEFAULT_MIN_DELAY_SECONDS=2
WORKER_CONCURRENCY=5

# Encryption Key (32-byte hex string for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 (Optional - Demo login works out of the box)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 & Alerts (Optional - Manual webhook entry works out of the box)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP Configuration (Optional - Auto-provisions ephemeral Ethereal test account if empty)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=oliver.brown@domain.io
