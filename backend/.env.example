# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Redis Configuration (BullMQ Persistent Delayed Queue & Distributed Rate Limiting)
# ==============================================================================
# Option A: Unified Redis Connection String (Recommended for Upstash TCP)
# Note: Use the ioredis/Node.js rediss:// TCP endpoint provided in the Upstash console.
# Do NOT use the Upstash REST API endpoint (https://...).
# Example: REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=

# Option B: Discrete Parameters (Local Redis or self-hosted)
# For local Redis: REDIS_HOST=localhost, REDIS_PORT=6379, REDIS_TLS=false
# For Upstash TCP: REDIS_HOST=YOUR_ENDPOINT.upstash.io, REDIS_PORT=6379, REDIS_USERNAME=default, REDIS_PASSWORD=YOUR_PASSWORD, REDIS_TLS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# Option A: Connection String (Recommended for Neon or Supabase)
# - Neon:     postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Option B: Discrete Parameters (Local PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=reachinbox_scheduler
DATABASE_SSL=false
# SSL Certificate Verification:
# By default, when SSL is enabled, strict CA certificate verification is enforced (rejectUnauthorized: true).
# Neon and Supabase certificates are signed by trusted public CAs (Let's Encrypt) and work with strict verification.
# Only set DATABASE_SSL_ALLOW_INSECURE=true if your environment strictly requires self-signed/insecure certs (e.g. local test proxy).
DATABASE_SSL_ALLOW_INSECURE=false
DATABASE_POOL_MAX=10

# ==============================================================================
# Email SMTP Delivery Configuration (Ethereal Sandbox vs Production SMTP / Gmail)
# ==============================================================================
# SMTP_PROVIDER: 'ethereal' (default testing), 'gmail' (real Google delivery), or 'custom'
SMTP_PROVIDER=ethereal

# Development default (Ethereal sandbox):
# If SMTP_PROVIDER=ethereal (or left blank), ReachInbox will dynamically provision
# an ephemeral Ethereal test account on the fly and log preview links.
# NOTE: Ethereal is a mock developer sandbox and does NOT deliver to real mailboxes.
#
# Real Gmail Delivery (Recommended for actual inbox delivery):
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Go to Security -> App passwords (https://myaccount.google.com/apppasswords)
# 3. Create app name "ReachInbox" and copy the 16-character generated password
# 4. Set:
#    SMTP_PROVIDER=gmail
#    SMTP_USER=your_email@gmail.com
#    SMTP_PASS=xxxx xxxx xxxx xxxx
#    EMAIL_FROM=Your Name <your_email@gmail.com>
#
# Custom Production SMTP (Brevo, SendGrid, Amazon SES):
#    SMTP_PROVIDER=custom
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your_login
#    SMTP_PASS=your_key
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ReachInbox Scheduler <scheduler@reachinbox.ai>

# ==============================================================================
# Slack Integration (OAuth & Incoming Webhook)
# ==============================================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_WEBHOOK_URL=

# ==============================================================================
# Google OAuth 2.0 (Optional - Demo login works out of the box)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ==============================================================================
# Elasticsearch (Full-Text Search Engine - Optional with Postgres Fallback)
# ==============================================================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ==============================================================================
# Security & Rate Limiting (Required in Production)
# ==============================================================================
# Generate a 32-byte hex key in PowerShell:
# [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=reachinbox_secure_session_secret_key_64_bytes_example_token!
DEFAULT_HOURLY_LIMIT=200
DEFAULT_MIN_DELAY_SECONDS=2
WORKER_CONCURRENCY=5
ADMIN_EMAILS=admin@reachinbox.ai,oliver.brown@domain.io
