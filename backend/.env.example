# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Redis Configuration (BullMQ Persistent Delayed Queue)
# For local Redis: REDIS_HOST=localhost, REDIS_PORT=6379, leave REDIS_USERNAME blank, REDIS_TLS=false
# For Upstash / Managed Redis: REDIS_USERNAME=default and REDIS_TLS=true (required for rediss:// TLS connections)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# PostgreSQL Database Configuration
# Provide either DATABASE_URL or individual PG credentials
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=reachinbox_scheduler
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Email SMTP Delivery Configuration (Ethereal Email / Fake SMTP)
# If SMTP_USER and SMTP_PASS are omitted, an ephemeral Ethereal test account will be automatically provisioned
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ReachInbox Scheduler <scheduler@reachinbox.ai>
